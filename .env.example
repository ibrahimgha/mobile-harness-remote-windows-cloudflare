# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# The text PowerShell uses to find the running Codex desktop window.
CODEX_WINDOW_TITLE=Codex

# Default is false. Leave it false until auth is configured.
ENABLE_WINDOW_CONTROL=false

# Required for real window control. The web UI sends this value as x-control-token.
CONTROL_TOKEN=

# SIDE-KEYBOARD completion light. Enabled by default on Windows.
CONTROL_ROOM_LED_ENABLED=true

# Audio-first dictation. OPENAI_API_KEY is required; recordings never use browser speech recognition.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Comma-separated spellings for people whose names should always be included in transcription context.
DICTATION_HUMAN_NAMES=
DICTATION_MAX_AUDIO_BYTES=26214400

# Optional folder where "new project" creates project directories. Defaults to the OS user home folder.
CODEX_NEW_PROJECTS_ROOT=
