{
  "name": "codex-window-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run check:ios-composer && npm run check:message-refresh && npm run check:run-settings && npm run check:chat-drafts && tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 install",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 uninstall",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 start",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 stop",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 restart",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service.ps1 status",
    "tunnel:dev": "cloudflared tunnel --url http://localhost:5173",
    "tunnel:prod": "cloudflared tunnel --url http://localhost:8787",
    "check": "npm run check:ios-composer && npm run check:message-refresh && npm run check:run-settings && npm run check:chat-drafts && tsc -b && tsc -p tsconfig.server.json",
    "check:ios-composer": "node scripts/check-ios-composer.mjs",
    "check:message-refresh": "tsx scripts/check-message-refresh.ts",
    "check:run-settings": "tsx scripts/check-run-settings.ts",
    "check:chat-drafts": "tsx scripts/check-chat-drafts.ts"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
